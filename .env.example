# ===== TikTok =====
TIKTOK_USERNAME=your_tiktok_username
# الـ ID الداخلي للحساب (أدق من اليوزر)
TIKTOK_SEC_UID=
# اختياري: لو تيك توك بيرفض الطلبات، صدّر الكوكيز من المتصفح لملف واكتب مساره هنا
TIKTOK_COOKIES_FILE=
# كل كام دقيقة الايجنت يشيك على فيديوهات جديدة
CHECK_EVERY_MINUTES=15
# false = أول تشغيل يتجاهل الفيديوهات القديمة وينشر الجديد بس
BACKFILL=false

# ===== الذكاء الاصطناعي (مجاني) =====
# gemini (مجاني بمفتاح من Google AI Studio) أو ollama (محلي على جهازك 100% مجاني)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# لغة/لهجة العناوين
CAPTION_LANGUAGE=العربية باللهجة المصرية

# ===== المنصات (اكتب false لأي منصة مش عاوز تنشر عليها) =====
ENABLE_YOUTUBE=true
# فيسبوك محتاج "صفحة" — لو عندك بروفايل شخصي بس، خليه false وفعّل المشاركة التلقائية من انستا (شوف README)
ENABLE_FACEBOOK=false
ENABLE_INSTAGRAM=true

# ===== YouTube =====
# ملف client_secret.json اللي هتنزله من Google Cloud Console
YOUTUBE_CLIENT_SECRET=client_secret.json
# public / unlisted / private
YOUTUBE_PRIVACY=public

# ===== Meta =====
META_GRAPH_VERSION=v23.0

# --- Instagram (Creator/Business) بدون صفحة فيسبوك: توكن من "Instagram Login" ---
# الايجنت بيجدده لوحده كل أسبوع
IG_ACCESS_TOKEN=
# سيبه فاضي (هيستخدم me تلقائي)
IG_USER_ID=

# --- Facebook Page (اختياري، لو عملت صفحة) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
